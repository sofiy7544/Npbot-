# Скопіюйте у server/.env і заповніть. server/.env у git НЕ комітиться.

# Порт сайту
PORT=8080

# --- Telegram: куди падають замовлення ---
# Токен бота від @BotFather
TG_BOT_TOKEN=
# ID чату/групи (для групи — відʼємне число, напр. -1001234567890).
# Як дізнатись: додайте бота в групу, напишіть щось, відкрийте
# https://api.telegram.org/bot<TOKEN>/getUpdates і знайдіть "chat":{"id":...}
TG_CHAT_ID=

# --- Резервна копія замовлень у файл (JSON Lines) ---
# Шлях від папки stanley-landing. "off" — вимкнути.
ORDERS_FILE=server/data/orders.jsonl

# --- Якщо сайт і сервер на різних доменах (напр. сайт на Netlify) ---
# Через кому: https://example.com,https://www.example.com
ALLOWED_ORIGINS=

# Сервер за nginx / Cloudflare / Render — щоб ліміт рахувався по реальному IP
TRUST_PROXY=0

# Антиспам: не більше RATE_MAX нових замовлень з одного IP за RATE_WINDOW_MIN хвилин
RATE_MAX=6
RATE_WINDOW_MIN=10
