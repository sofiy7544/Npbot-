# Скопируйте в .env и заполните своими значениями:
#   cp .env.example .env

# Токен бота от @BotFather
WLED_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# IP-адрес устройства WLED в локальной сети
WLED_IP=192.168.1.106

# Разрешённые Telegram ID через запятую (узнать у @userinfobot).
ALLOWED_USERS=123456789

# Порт веб-приложения для телефона (открой http://IP-ПК:8080 на айфоне).
# Поставь 0, чтобы выключить веб-приложение.
WEB_PORT=8080

# IP телевизора Samsung (для вкладки «ТВ»). Можно оставить пустым и
# ввести прямо в приложении. IP смотри в ТВ: Настройки → Сеть → Состояние.
SAMSUNG_TV_IP=

# «Интеллект»: ключ OpenAI. Если пусто — бот работает на правилах (как раньше).
# С ключом понимает свободную речь: «сделай уютно», «что-то скучно, оживи».
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# ===== Панель из интернета (2.3.0) =====
# Пароль панели. Для выхода в интернет — ОБЯЗАТЕЛЬНО свой, от 6 символов.
ACCESS_PASSWORD=
# 1 — поднимать туннель Cloudflare (бесплатно, без аккаунта), чтобы сайт панели
# работал вне квартиры. 0 — только домашняя сеть.
TUNNEL=1
# Сайт панели на GitHub Pages (чтобы адрес был постоянным). Необязательно.
# PAGES_URL — адрес сайта; GITHUB_PAGES_REPO — репозиторий сайта (владелец/имя);
# GITHUB_TOKEN — токен с правом contents:write на этот репозиторий: бот сам
# записывает туда актуальный адрес туннеля (api.json).
PAGES_URL=
GITHUB_PAGES_REPO=
GITHUB_TOKEN=
# Старый веб-пульт :8080 (заменён единым сайтом). 0 — выключен.
WEB_PORT=0
