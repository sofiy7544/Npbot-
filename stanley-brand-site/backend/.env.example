# ============================================================
# Stanley Brand UA — backend environment
# Copy this file to ".env" (same directory) and fill in values.
# .env MUST NOT be committed to git.
# ============================================================

# --- Monobank acquiring ---
# Get from https://web.monobank.ua → Налаштування → Інтернет-еквайринг → API ключ
MONOBANK_TOKEN=PASTE_YOUR_MONOBANK_PRODUCTION_TOKEN_HERE

# --- Telegram bot (for forwarding orders to your team group) ---
# This is the token you provided. Treat as secret.
TELEGRAM_BOT_TOKEN=<YOUR_TELEGRAM_BOT_TOKEN>

# Chat ID of the group where the bot posts new orders. To find it:
#   1) Add the bot to your group AND make it admin.
#   2) Send any message in the group.
#   3) Open https://api.telegram.org/bot<TOKEN>/getUpdates
#   4) Find the most recent "chat":{"id":-XXXXXXXX,...} — that's the chat_id.
#      Group IDs are negative numbers (e.g. -1001234567890 for supergroups).
TELEGRAM_CHAT_ID=

# --- Server config ---
PORT=8787

# Public origin where your storefront is hosted. Used to build absolute URLs
# for product photos in Telegram messages and to lock CORS.
PUBLIC_ORIGIN=https://stanleybrandua.com

# Comma-separated list of allowed origins for CORS (frontend can call this API)
ALLOWED_ORIGINS=https://stanleybrandua.com,https://www.stanleybrandua.com,http://localhost:5500,http://127.0.0.1:5500

# Where the user is redirected after paying (defaults to PUBLIC_ORIGIN + /#payment-result)
PUBLIC_REDIRECT_URL=
