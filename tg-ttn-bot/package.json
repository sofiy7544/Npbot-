{
  "name": "tg-ttn-bot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Production Telegram-to-NovaPoshta bridge. Reads orders from chats, parses with NLP/regex, creates TTN via NP API.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:legacy": "tsx watch src/index.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:parser:legacy": "tsx src/parser.test.ts && tsx src/parser.stress.test.ts && tsx src/parser.mass.test.ts && tsx src/parser.real.test.ts",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "worker": "tsx src/jobs/worker.ts",
    "admin": "tsx src/presentation/admin/server.ts",
    "sync:warehouses": "tsx src/jobs/warehouse-sync-cli.ts",
    "sync:warehouses:dry": "tsx src/jobs/warehouse-sync-cli.ts -- --dry-run --max=5"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@prisma/client": "^5.22.0",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.1.0",
    "grammy": "^1.43.0",
    "ioredis": "^5.4.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prisma": "^5.22.0",
    "tsx": "^4.22.1",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
