# ════════════════════════════════════════════════════════════════════
# tg-ttn-bot — змінні для хмарного деплою (Railway / Render / Fly).
#
# Це НЕ файл, який треба комітити чи заливати на сервер: у хмарі змінні
# вписуються в дашборд провайдера. Тут — точний список того, що вписати.
# Повний перелік усіх опцій — у .env.example.
# ════════════════════════════════════════════════════════════════════

# ─── 1. ОБОВ'ЯЗКОВО ─────────────────────────────────────────────────
NODE_ENV=production
TG_BOT_TOKEN=                         # від @BotFather

# Chat ID групи із замовленнями (з мінусом!) + твій особистий ID.
# Дізнатись: додай бота в групу й напиши /whoami
# Порожнє = бот приймає будь-який чат. У проді так НЕ лишати.
ALLOWED_CHAT_IDS=
ADMIN_TG_IDS=

# ─── 2. Підставляє провайдер ────────────────────────────────────────
# Railway/Render дають ці рядки самі — прив'яжи їх як посилання на
# змінні Postgres/Redis, не вписуй руками.
#   Railway:  ${{Postgres.DATABASE_URL}}   ${{Redis.REDIS_URL}}
# PORT теж ставить провайдер — health-сервер слухає саме його.
DATABASE_URL=
REDIS_URL=

# ─── 3. Nova Poshta ─────────────────────────────────────────────────
# Поки NP_API_KEY порожній — бот у MOCK-режимі: ТТН фейкові (9999...).
# Це нормальний перший деплой: спершу переконайся, що бот живий.
NP_API_KEY=
NP_SENDER_CITY_REF=
NP_SENDER_WAREHOUSE_REF=
NP_SENDER_REF=
NP_SENDER_CONTACT_REF=
NP_SENDER_PHONE=

# ─── 4. Необов'язкове ───────────────────────────────────────────────
LOG_LEVEL=info
# AI-фолбек парсера. Порожнє = вимкнено, працює лише регексп-парсер.
ANTHROPIC_API_KEY=

# ─── ЧОГО НЕ СТАВИТИ ────────────────────────────────────────────────
# TG_WEBHOOK_URL — webhook-режим не реалізований (немає HTTP-приймача).
#   Якщо виставити — бот впаде на старті з явною помилкою. Це навмисно:
#   інакше Telegram перестав би слати апдейти і бот мовчки «оглух» би.
#   У хмарі працює long-polling, вихідних з'єднань достатньо.
# ADMIN_API_TOKEN — admin-сервера в коді ще немає. Лишай порожнім.
