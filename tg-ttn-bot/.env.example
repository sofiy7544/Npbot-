# ════════════════════════════════════════════════════════════════════
# tg-ttn-bot v2 — Production Telegram → Nova Poshta TTN bridge
# Copy as .env and fill in values. See PRODUCTION-AUDIT.md for prod tuning.
# ════════════════════════════════════════════════════════════════════

# ─── Runtime ────────────────────────────────────────────────────────
NODE_ENV=development                  # development | test | staging | production
LOG_LEVEL=info                        # fatal | error | warn | info | debug | trace
LOG_FILE=logs/bot.log

# ─── Telegram ───────────────────────────────────────────────────────
TG_BOT_TOKEN=                         # From @BotFather — REQUIRED
# Webhook mode (optional). If empty → long-polling.
# Set both TG_WEBHOOK_URL and TG_WEBHOOK_SECRET for prod.
TG_WEBHOOK_URL=                       # https://example.com/webhook/tg
TG_WEBHOOK_SECRET=                    # X-Telegram-Bot-Api-Secret-Token

# Comma-separated chat IDs (negative for groups, e.g. -1001234567890)
# Empty → allow any chat (dev only — set in prod!)
ALLOWED_CHAT_IDS=
# Telegram IDs of admins (separated by commas) — bypass all whitelist checks
ADMIN_TG_IDS=

# ─── Database ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://tgbot:tgbot@localhost:5432/tgttnbot

# ─── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Nova Poshta API ────────────────────────────────────────────────
# MOCK_MODE — empty/false = auto (mock if NP_API_KEY missing); "true" = force mock
NP_MOCK_MODE=
NP_API_KEY=                           # https://new.novaposhta.ua/dashboard/settings/security
NP_API_URL=https://api.novaposhta.ua/v2.0/json/
NP_API_TIMEOUT_MS=10000
NP_API_MAX_RETRIES=3
NP_API_RATE_LIMIT_PER_SEC=8           # NP free tier ~10/s; keep margin

# Sender details — REQUIRED for production (ignored in MOCK mode)
NP_SENDER_CITY_REF=                   # UUID of sender city (e.g. Київ: 8d5a980d-391c-11dd-90d9-001a92567626)
NP_SENDER_WAREHOUSE_REF=              # UUID of sender warehouse
NP_SENDER_REF=                        # Counterparty (Sender) UUID
NP_SENDER_CONTACT_REF=                # ContactPerson UUID
NP_SENDER_PHONE=                      # +380XXXXXXXXX

# Default cargo settings (overridable per-message)
NP_DEFAULT_WEIGHT_KG=0.6
NP_DEFAULT_VOLUME_M3=0.0004           # ~8×8×18 см термокухоль; required for CargoType=Cargo
NP_DEFAULT_DESCRIPTION=Термокухоль
NP_DEFAULT_SERVICE_TYPE=WarehouseWarehouse  # WarehouseWarehouse | WarehouseDoors | DoorsDoors | DoorsWarehouse
NP_DEFAULT_PAYER=Recipient            # Sender | Recipient
NP_DEFAULT_PAYMENT_METHOD=Cash        # Cash | NonCash

# ─── AI Fallback (Claude) ───────────────────────────────────────────
# Used ONLY when regex parser fails to extract all required fields.
# Cached for 30 days by message hash — same message = zero AI cost on replay.
ANTHROPIC_API_KEY=                    # Optional; if missing, AI fallback disabled
ANTHROPIC_MODEL=claude-3-5-haiku-20241022  # cheap + fast; bump to sonnet for harder cases
OPENAI_API_KEY=                       # Fallback if Claude unavailable
OPENAI_MODEL=gpt-4o-mini

# ─── Draft state ────────────────────────────────────────────────────
DRAFT_TTL_MS=600000                   # 10 min — drafts auto-cancel after this
REDIS_CACHE_NP_TTL_S=604800           # 7 days NP refs cache

# ─── Rate limiting ──────────────────────────────────────────────────
RATE_LIMIT_PER_USER_PER_MIN=20        # Anti-spam — per-user msg/min limit
RATE_LIMIT_GLOBAL_PER_SEC=50          # Global circuit breaker

# ─── Admin API ──────────────────────────────────────────────────────
ADMIN_API_ENABLED=true
ADMIN_API_HOST=0.0.0.0
ADMIN_API_PORT=3001
ADMIN_API_TOKEN=                      # ≥16 chars random — for Bearer auth on /admin/*

# ─── Observability ──────────────────────────────────────────────────
SENTRY_DSN=                           # Optional — error tracking
METRICS_PORT=9464                     # Prometheus /metrics endpoint
