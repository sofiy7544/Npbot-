# ── Telegram ──────────────────────────────────────────────────────────
# Токен бота от @BotFather
TG_BOT_TOKEN=123456:ВСТАВЬ_СВОЙ_ТОКЕН

# Кто может управлять лампой. Пусто = любой, кто напишет боту.
# Иначе — свой Telegram user_id (узнать: @userinfobot), можно несколько через запятую.
ALLOWED_USERS=

# ── Интеллект (опционально) ───────────────────────────────────────────
# Ключ OpenAI. Если пусто — бот всё равно работает, но на простом парсере,
# без понимания намёков. С ключом лампа понимает фразы вроде «мне уютно хочется».
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# ── Какой лампой управлять ────────────────────────────────────────────
# sim      — симулятор (по умолчанию), рисует лампу картинкой, железо не нужно
# yeelight — реальная лампа Yeelight/Xiaomi по локальной сети
LAMP_BACKEND=sim

# Только для LAMP_BACKEND=yeelight. IP лампы в локальной сети.
# В приложении Yeelight включи «Режим LAN»/«Для разработчиков», иначе не ответит.
YEELIGHT_IP=
